{
  "name": "conduit.js",
  "version": "1.0.0",
  "description": "Execute and manage non-JavaScript languages (Python, Ruby, Java, C, C#) from JavaScript in Node.js, React, Next.js, Vue, Angular, and all modern frameworks.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.mjs",
      "require": "./dist/native.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "esbuild src/index.ts src/native.ts src/react.ts --bundle --outdir=dist --format=esm --platform=node",
    "build:js:cjs": "esbuild src/index.ts src/native.ts src/react.ts --bundle --outdir=dist --format=cjs --platform=node",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "dev": "esbuild src/index.ts src/native.ts src/react.ts --bundle --outdir=dist --format=esm --watch",
    "lint": "tsc --noEmit",
    "test": "node dist/index.js",
    "test:native": "node dist/native.js",
    "test:react": "node test/react.test.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssar-group/conduit.js.git"
  },
  "keywords": [
    "javascript",
    "typescript",
    "openjs",
    "python",
    "ruby",
    "java",
    "c",
    "csharp",
    "execute",
    "script",
    "runtime",
    "cross-language",
    "polyglot",
    "node",
    "react",
    "nextjs",
    "vue",
    "angular",
    "svelte",
    "framework-agnostic",
    "child-process",
    "subprocess",
    "language-bridge",
    "interop",
    "ssar",
    "development",
    "environment"
  ],
  "author": "SSAR Group <contact@ssar-group.com> (https://ssar-group.com)",
  "contributors": [
    {
      "name": "SSAR Group",
      "email": "contact@ssar-group.com"
    }
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ssar-group/conduitjs/issues"
  },
  "homepage": "https://github.com/ssar-group/conduit.js#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.7",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
