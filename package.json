{
  "name": "@ssar-group/conduit.js",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssar-group/conduit.js"
  },
  "description": "Execute external scripts (Python, Ruby, Java, C, C#) from Node.js and React",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG",
    "LICENSE",
    "conduit-config.d.ts"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./native": {
      "import": "./dist/native.js",
      "types": "./dist/native.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "test:examples": "node examples/test.js",
    "check": "npm run typecheck && npm test && npm run test:examples",
    "prepack": "npm run check"
  },
  "keywords": [
    "conduit",
    "python",
    "ruby",
    "java",
    "script-execution",
    "child-process"
  ],
  "author": "@ssar-group",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.7",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
